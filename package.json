    "bench:kaggle-eleanor:openai": "node --env-file=.env.local --import tsx tests/kaggle-eleanor.openai-redacted.ts",
    "bench:kaggle-eleanor:timeline": "tsx tests/kaggle-eleanor.timeline.ts",
    "test:live-claude": "node --env-file=.env.local --import tsx tests/live-claude.ts",
