    "expo-system-ui": "~56.0.5",
    "expo-task-manager": "~56.0.15",
    "jsonrepair": "^3.14.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-executorch": "^0.9.0",
    "react-native-executorch-expo-resource-fetcher": "^0.9.0",
